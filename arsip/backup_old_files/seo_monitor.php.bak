checkLogin();

// SEO Scoring Logic
function calculateSeoScore($article) {
    $score = 100;
    $issues = [];
    
    // 1. Title Check
    $title = $article['seo_title'] ?: $article['title'];
    $titleLen = strlen($title);
    if ($titleLen < 30 || $titleLen > 70) {
        $score -= 10; 
        $issues[] = "Title length Critical (<30 or >70)";
    } elseif ($titleLen > 60) {
        $score -= 5;
        $issues[] = "Title length Warning (61-70)";
    }
    
    // 2. Desc Check
    $desc = $article['seo_description']; 
    $descLen = strlen($desc);
    
    if ($descLen == 0) {
        $score -= 40;
        $issues[] = "Meta Description kosong!";
    } elseif ($descLen < 100 || $descLen > 170) {
        $score -= 10;
        $issues[] = "Meta Desc Critical (<100 or >170)";
    } elseif ($descLen > 160) {
        $score -= 5;
        $issues[] = "Meta Desc Warning (161-170)";
    }
    
    // 3. Image Alt (Simple check if image exists)
    if (empty($article['image_path'])) {
        $score -= 10;
        $issues[] = "Tidak ada gambar utama";
    }

    return ['score' => $score, 'issues' => $issues];
}

$stmt = $pdo->query("SELECT id, title, slug, seo_title, seo_description, image_path, status, created_at, seo_score, seo_audit_log FROM articles WHERE status='published' ORDER BY created_at DESC");
$articles = $stmt->fetchAll(PDO::FETCH_ASSOC);

require_once 'includes/header.php';
?>

