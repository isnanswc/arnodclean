                                    $d = $art['seo_description'];
                                    $len = strlen($d);
                                    $cls = ($len >= 100 && $len <= 160) ? 'text-success' : (($len > 160 && $len <= 170) ? 'text-warning' : 'text-danger');
                                ?>
                                <div class="<?php echo $cls; ?> fw-bold"><?php echo $len; ?> chars</div>
                                <small class="text-muted d-block text-truncate" style="max-width: 200px;"><?php echo htmlspecialchars($d); ?></small>
