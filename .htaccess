RewriteEngine On

# --- CANONICAL DOMAIN & SSL (PRODUCTION) ---
# 1. Force HTTPS for arnod-clean.com
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?arnod-clean\.com$ [NC]
RewriteRule ^(.*)$ https://arnod-clean.com/$1 [R=301,L]

# 2. Redirect WWW to Non-WWW
RewriteCond %{HTTP_HOST} ^www\.arnod-clean\.com$ [NC]
RewriteRule ^(.*)$ https://arnod-clean.com/$1 [R=301,L]

# 3. Strip index.php to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php [NC]
RewriteRule ^index\.php$ / [R=301,L]

# --- SECURITY RULES ---
# 1. Disable Directory Browsing
Options -Indexes

# 2. Block Direct Access to Sensitive Files, Dumps, Logs, and Scripts
<FilesMatch "(\.(sql|log|bak|lock|env|git|sh|bat)$)|(^error_log$)|(^config(\.local)?\.php$)|(^db(_old)?\.php$)|(composer\.(json|lock)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- SEO PRETTY URLS ---
# Map /blog -> blog.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/?$ blog.php [L,QSA]

# Map /blog/<slug> -> article.php?slug=<slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
